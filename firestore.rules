rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmail(email) {
      return isSignedIn() && ('email' in request.auth.token) && request.auth.token.email.lower() == email.lower();
    }
    
    function isAdmin() {
      return isEmail('tijlvanherpen@icloud.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Profiles: Users can read/write their own profiles. Admins can do anything.
    match /profiles/{email} {
      allow read, write: if isAdmin() || isEmail(email);
    }

    // Content: Publicly readable, admin writable.
    match /content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Clues: Readable by everyone, writable by signed-in users.
    match /clues/{clueId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Reports: Users can create and read their own. Admins can read/update.
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && ('email' in request.auth.token) && resource.data.userEmail.lower() == request.auth.token.email.lower());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
